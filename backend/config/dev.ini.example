# Template for the backend configuration file.
#
#   copy config\dev.ini.example config\dev.ini     (then fill in the blanks)
#
# config.py reads config/dev.ini by default, or config/prod.ini when
# APP_ENV=production. Precedence, first hit wins:
#
#   1. a real environment variable   -- the name is listed above each key
#   2. a variable in backend/.env
#   3. the value written here
#   4. config.py's built-in default
#
# so a production host can inject its secrets without putting them on disk.
#
# Values are read literally -- no %(...)s interpolation, so '%', '$' and
# spaces need no escaping. Comments must be on their own line; anything after
# '=' is part of the value. A key left blank falls back to the built-in
# default, except where blank is itself the documented answer.

[server]
# FLASK_ENV / APP_ENV -- development | testing | production
environment = development

# DATABASE_URL -- required. Percent-encode any of @ : / ? # in the password,
# since this is a URL and those would be read as delimiters. Keep
# ?charset=utf8mb4 or non-ASCII transcript text is mangled going into MySQL.
sqlalchemy_database_uri = mysql+pymysql://root:PASSWORD@127.0.0.1:3306/hospital?charset=utf8mb4
# TEST_DATABASE_URL -- used only by TestingConfig, never by a running server.
# Blank derives it by appending _test to the database named above.
sqlalchemy_test_database_uri =
# SQLALCHEMY_TRACK_MODIFICATIONS -- leave false. Nothing here listens for the
# SQLAlchemy signals it powers, and it costs memory and time on every write.
sqlalchemy_track_modifications = False
# SQL_ECHO -- log every statement. Noisy; useful when chasing a query.
sqlalchemy_echo = False
# Only ProductionConfig applies size/overflow/timeout -- the dev server is
# single-user and does not need a tuned pool.
# DB_POOL_SIZE / DB_MAX_OVERFLOW / DB_POOL_TIMEOUT / DB_POOL_RECYCLE
sqlalchemy_pool_size = 10
sqlalchemy_max_overflow = 20
sqlalchemy_pool_timeout = 30
# Below MySQL's wait_timeout, so a pooled connection is never a dead one.
sqlalchemy_pool_recycle = 280

# SECRET_KEY -- long random string, generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
app_secret_key =
# PORTAL_BASE_URL -- where the React app is reachable. Encoded in the QR code
# printed on consultation reports so a scan opens the record.
frontend_base_url = http://localhost:5173
# CORS_ORIGINS -- comma-separated list of origins allowed to call /api/*.
cors_origins = http://localhost:5173

[jwt]
# JWT_SECRET_KEY -- a second, different random string
secret_key =
# JWT_ACCESS_MINUTES -- 480 = an 8-hour shift
access_token_expires_minutes = 480
# JWT_REFRESH_DAYS
refresh_token_expires_days = 30

[upload_folder]
# UPLOAD_FOLDER -- avatars and patient photos. A relative path resolves
# against backend/, not the working directory. Point this at a mounted volume
# in production so uploaded images survive a redeploy.
upload_folder = uploads

[gemini]
# GEMINI_API_KEY
api_key =
# GEMINI_MODEL
model = gemini-flash-latest

[whisper]
# WHISPER_MODEL -- tiny | base | small | medium | large
model = small
# WHISPER_LANGUAGE -- leave empty so Whisper auto-detects the spoken language
# per segment (handles English/Hindi/Telugu/Tamil code-switching); it always
# translates to English. Empty is the intended value, not a blank to fill.
language =

# Printed on the consultation report letterhead and footer.
[hospital]
# HOSPITAL_NAME
name = Yasodha Hospitals
# HOSPITAL_TAGLINE
tagline = Compassionate care, every day
# HOSPITAL_ADDRESS
address =
# HOSPITAL_PHONE
phone =
# HOSPITAL_EMAIL
email =
# HOSPITAL_WEBSITE
website =
